{
  "manifest_version": 3,
  "name": "Logging Console Vite Test HMR",
  "version": "1.0",
  "description": "A console that logs all the messages",
  "icons": {
    "128": "console.png"
  },
  "action": { "default_popup": "index.html" },
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "https://localhost/*"],
      "js": ["jsonView.js", "content.js"],
      "style": ["jsonView.css", "styles.css"]
    }
  ],
  "permissions": ["activeTab", "scripting", "sidePanel", "storage"],
  "web_accessible_resources": [
    {
      "resources": ["injected-script.js", "https://cdn.jsdelivr.net/*"],
      "matches": ["http://localhost/*", "https://localhost/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "background": {
    "service_worker": "background.js"
  }
}
